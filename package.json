{
  "name": "dnevnik-duhovnoy-praktiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @app/api",
    "dev:bot": "npm run dev -w @app/bot",
    "dev:mini-app": "npm run dev -w @app/mini-app",
    "start:api": "npm run start -w @app/api",
    "start:bot": "npm run start -w @app/bot",
    "typecheck": "tsc --noEmit",
    "test": "npm run test -w @app/api",
    "clean": "tsc --build --clean",
    "worker:dev": "wrangler dev",
    "worker:deploy": "node scripts/build-mini-app-prod.mjs && wrangler deploy",
    "worker:tail": "wrangler tail",
    "d1:create": "wrangler d1 create dharma-diary",
    "d1:migrate": "wrangler d1 migrations apply dharma-diary --remote",
    "d1:migrate:local": "wrangler d1 migrations apply dharma-diary --local"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
