# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-ваш-токен-от-botfather

# API
PORT=3001
APP_DATABASE_PATH=/app/data/app.sqlite

# Mini App (HTTPS обязателен!)
VITE_API_URL=https://your-domain.com

# Bot configuration (для docker-compose)
MINI_APP_URL=https://your-domain.com
API_BASE_URL=http://localhost:3001

# Служебный токен для вызовов «бот → API» (эндпоинты уведомлений).
# ОБЯЗАТЕЛЕН: без него бот не сможет читать и отправлять уведомления.
# Один и тот же секрет должен быть у сервисов api и bot.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# Разрешить заголовок x-user-id (ТОЛЬКО для локальной разработки, никогда в production)
# ALLOW_DEV_AUTH=1

# Идентификатор пользователя для локального запуска Mini App в обычном браузере.
# ВАЖНО: Vite читает .env только из каталога проекта, поэтому эту переменную нужно
# положить в apps/mini-app/.env — в корневом .env её Vite не увидит.
# Без неё приложение не отправит заголовок авторизации и покажет демо-данные,
# а созданные практики не сохранятся.
# VITE_DEV_USER_ID=local-dev-user

# AI Providers (опционально)
GOOGLE_API_KEY=
GOOGLE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_MODELS=deepseek/deepseek-v4-flash,gpt-4o-mini
